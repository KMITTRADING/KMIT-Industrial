# Public site origin. Used for canonicals, hreflang, sitemap, OG URLs and
# JSON-LD @id values. No trailing slash. Nothing in the codebase may hardcode a
# domain — see src/lib/env.ts, which fails the build if this is malformed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which RFQ driver submitRfq() dispatches to.
#   console  — logs the payload to the server console. The shipped default.
#   resend   — sends a transactional email. Requires RESEND_API_KEY and RFQ_TO_EMAIL.
#   webhook  — POSTs the payload as JSON. Requires RFQ_WEBHOOK_URL.
RFQ_DRIVER=console

# Required when RFQ_DRIVER=resend
RESEND_API_KEY=
RFQ_TO_EMAIL=
RFQ_FROM_EMAIL=

# Required when RFQ_DRIVER=webhook
RFQ_WEBHOOK_URL=
RFQ_WEBHOOK_SECRET=
