{
  "name": "kmit-industrial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:direction": "node scripts/check-direction.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:direction && npm run check:copy",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "check:dom": "node scripts/check-dom.mjs",
    "check:crawl": "node scripts/check-crawl.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:seo": "npm run check:dom && npm run check:crawl && npm run check:schema",
    "check:client-messages": "node scripts/check-client-messages.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:e2e",
    "check:budget": "node scripts/check-budget.mjs",
    "check:runtime": "npm run audit:a11y && npm run check:dom && npm run check:crawl && npm run check:schema && npm run check:rtl && npm run check:budget"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "node-html-parser": "^9.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
